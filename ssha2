# NUL, SOH, STX, ENQ, ACK, SO, SI, DLE, DC4, EM, GS, RS, US : ttyで一般的に使われない制御コード（強調対象）
TTY_UNUSED_CONTROL_BYTES = [0x00, 0x01, 0x02, 0x05, 0x06, 0x0E, 0x0F, 0x10, 0x14, 0x19, 0x1D, 0x1E, 0x1F].freeze

CTRL_ESCAPE_BG_YELLOW = "\e[43m"
CTRL_ESCAPE_FG_RED = "\e[31m"
CTRL_ESCAPE_FG_GREEN = "\e[32m"
CTRL_ESCAPE_RESET = "\e[0m"

def escapedByte(byte, fg)
	"#{CTRL_ESCAPE_BG_YELLOW}#{fg}<0x%02x>#{CTRL_ESCAPE_RESET}" % byte
end

# ASCII-8BIT文字列をUTF-8へ変換し、invalid/undefなバイト列は赤字/黄背景、
# ttyで一般的に使われない制御コードは緑字/黄背景で1バイトずつ<0xff>形式に強調する
def binaryToDisplayUtf8(bin)
	utf8 = bin.dup.force_encoding("UTF-8")
	scrubbed = utf8.scrub { |bytes|
		bytes.each_byte.map { |b| escapedByte(b, CTRL_ESCAPE_FG_RED) }.join
	}
	scrubbed.gsub(/[\x00-\x1f]/) { |c|
		TTY_UNUSED_CONTROL_BYTES.include?(c.ord) ? escapedByte(c.ord, CTRL_ESCAPE_FG_GREEN) : c
	}
end

	def split_completed_and_pending!(buf)
	  return [nil, buf] if buf.empty?

	  i = buf.bytesize - 1
	  cont = 0

	  while i >= 0 && (buf.getbyte(i) & 0b11000000) == 0b10000000
	    cont += 1
	    i -= 1
	  end

	  return [buf, nil] if cont == 0

	  lead = buf.getbyte(i)
	  need = case lead
	         when 0xC2..0xDF then 1
	         when 0xE0..0xEF then 2
	         when 0xF0..0xF4 then 3
	         else 0
	         end

	  if need > 0 && cont < need
	    pending_start = i + 1
	    completed = buf.byteslice(0, pending_start)
	    pending = buf.byteslice(pending_start, buf.bytesize - pending_start)

	    buf.replace(pending)
	    return [completed, pending]
	  end

	  [buf, nil]
	end




def genIOFiberCode code, cls
	%W{r w e}.each do |prefix|
		c = code.clone
		c.gsub! "io", prefix + "io"
		c.gsub! "IO", prefix.capitalize + "IO"
		c.gsub! "fiber", prefix + "fiber"
		c.gsub! "Fiber", prefix.capitalize + "Fiber"
		cls.class_eval c
	end
end

def insert_by array, item, &key
 	index = array.bsearch_index { |element| key.call(element) >= key.call(item) }
 	array.insert(index || array.length, item)
end

def sampleFromArrays *arrs
	alls = 0
	arrs.each do |a|
		alls += a.size
	end
	ord = rand 0 ... alls
	asz = 0
	arrs.each do |a|
		if ord < (asz += a.size)
			return a, a[asz - ord - 1]
		end
	end
end


class Fiber
	attr_reader :io, :mode
	def setIO io, mode
		if @io
			raise "#{self.inspect} is already waiting an IO, #{@io.inspect}"
		else
			@io = io
			@mode = mode
			case mode
			when :read
				SelectRIOList[io] = true
				@io._setRFiber self
			when :write
				SelectWIOList[io] = true
				@io._setWFiber self
			when :error
				SelectEIOList[io] = true
				@io._setEFiber self
			end
		end
	end
	def resetIO
		case @mode
		when :read
			SelectRIOList.delete @io
			@io._resetRFiber
		when :write
			SelectWIOList.delete @io
			@io._resetWFiber
		when :error
			SelectEIOList.delete @io
			@io._resetEFiber
		end
		@io = @mode = nil
	end
#	genIOFiberCode ioCode, self
	attr_reader :timeout
	def timeout_sec
		to_sec = @timeout - Time.now
		if to_sec < 0
			to_sec = 0
		end
		to_sec
	end
	
	@@FibersWithTimeout = []
	def setTimeout t # Time object
		@timeout = t
		insert_by(@@FibersWithTimeout, self) do |item|
			item.timeout
		end
	end
	def resetTimeout
		@timeout = nil
		@@FibersWithTimeout.each_with_index do |item, i|
			if item == self
				@@FibersWithTimeout.delete_at i
			end
		end
	end
	def self.timeout_sec
		@@FibersWithTimeout[0]&.timeout_sec
	end
	def self.timeoutList
		topTimeout = @@FibersWithTimeout[0]&.timeout
		if topTimeout
			ret = []
			@@FibersWithTimeout.each do |fib|
				if fib.timeout == topTimeout
					ret.push fib if !ret.include?(fib)
				else
					break
				end
			end
			ret
		else
			nil
		end
	end
	def self.cont fiber, exception = nil # in SelectFiber
		params = fiber.resume exception # dispatch!
		if params.is_a? Array
			tindex = params.find_index{|item| item&.is_a?(Time)}
			if tindex
				tout = params[tindex] rescue nil
				params.delete_at(tindex)
			else
				tindex = params.find_index{|item| item.nil?}
				params.delete_at(tindex) if tindex
			end
		end
		if tout
			fiber.setTimeout tout
		end
		if !params.empty?
			case params
			in :finish
			in :nest
			in IO => io, :read | :write | :error => mode
				fiber.setIO io, mode
			end
		end
	end

	SelectFiber = Fiber.new do
		begin
			loop do
				exception = nil
				tout = Fiber.timeout_sec
				tout_fibers = Fiber.timeoutList
				mayRaise = false
				re = IO::IOWithReadException.keys & SelectRIOList.keys
				we = IO::IOWithWriteException.keys & SelectWIOList.keys
				ee = IO::IOWithErrorException.keys & SelectEIOList.keys
				if [re, we, ee].any?{!_1.empty?}
					mayRaise = true
					if !tout || tout != 0
						tout = 0
						tout_fibers = []
					end
				end
				if SelectRIOList.empty? && (!tout_fibers || tout_fibers&.empty?) && SelectWIOList.empty? && SelectEIOList.empty?
					break
				end
				all = nil
				ord = nil
				rios = []
				fiber = nil
				arrived = nil
				begin
					rios, wios, eios = IO.select SelectRIOList.keys, SelectWIOList.keys, SelectEIOList.keys, tout
					if !rios
						if mayRaise
							arr, io = sampleFromArrays re, we, ee
							case arr
							when re
								exception = IO::IOWithReadException.delete(io)
								fiber = io.rfiber
							when we
								exception = IO::IOWithWriteException.delete(io)
								fiber = io.wfiber
							when ee
								exception = IO::IOWithErrorException.delete(io)
								fiber = io.efiber
							end
						else
							fiber = tout_fibers.sample
							exception = Timeout::Error
						end
					else
						all = rios + wios + eios
						arr, io = sampleFromArrays rios, wios, eios
						case arr
						when rios
							fiber = io.rfiber
						when wios
							fiber = io.wfiber
						when eios
							fiber = io.efiber
						end
					end
				ensure
					fiber&.resetIO
					fiber&.resetTimeout
				end
				cont fiber, exception
			end
		rescue Exception => e
			STDERR.puts e.full_message(highlight: false, order: :top)
			exit 1
		end		
	end
	MainFiber = Fiber.current

	def digest_call_info arg1 = nil, arg2 = nil
		lbl = Proc.new do |l|
			if l =~ /\<class:(.*)\>/
				$1
			else
				l
			end
		end
		case [arg1, arg2]
		in Array => ciarr, nil
			ord = 0
		in Integer => ord, nil
			ciarr = caller_locations
		in Array => ciarr, Integer => ord
		in Integer => ord, Array => ciarr
		end
		ciarr.reject!{|item| item.path == "<internal:kernel>"}
		orgPath = ciarr[0].path
		orgLno = ciarr[0].lineno
		orgLabel = ciarr[0].base_label
		str = ciarr[ord + 1..-1].reduce "#{orgPath.basename}:#{lbl.call orgLabel}:#{orgLno}" do |str, ci|
			s = []
			if orgPath != ci.path
				s.push File.basename(ci)
			end
			if orgLabel != ci.base_label
				s.push lbl.call(ci.base_label)
			end
			if orgLno != ci.lineno
				s.push ci.lineno.to_s
			end
			if !s.empty?
				str + ";" + s.join(":")
			else
				str
			end
		end
		str
	end

	OrgCI = Struct.new(:path, :base_label, :lineno)
	def set_fork_info
		oi = org_inspect
		if oi =~ /(\/.*):(\d+)/
			origin = OrgCI.new($1, caller_locations(1)[0].base_label, $2.to_i)
		end
		@fork_info = caller_locations(2)
		@fork_info.unshift origin
	end

	alias_method :org_inspect, :inspect

	def prop_inspects
		ia = instance_variables
		ia.delete("@fork_info".intern)
		m = ia.map do |name|
			"#{name}=#{instance_variable_get(name).inspect}"
		end
		ms = m.join(", ")
		if !ms.empty?
			" " + ms
		else
			""
		end
	end

	def inspect
		oi = org_inspect
		if oi =~ /(\/.*):(\d+)/
			oi = $` + digest_call_info(@fork_info) + prop_inspects + $'
		end
		oi
	end

	def self.fork
		f = Fiber.new do
			begin
				yield
			rescue Exception => e
				STDERR.puts e.full_message(highlight: false, order: :top)
  				exit 1
			end
			:finish
		end
		f.set_fork_info
		cont f
	end
	def self.pararell
		yield
#		loop do
			if Fiber.current == MainFiber
				SelectFiber.resume
			else
				Fiber.yield :nest
			end
#		end
	end

	class Unexpected < Exception
	end

	def self.wait *args
		ret = Fiber.yield *args # may return Exception
		case ret
		when Exception
			raise ret
		when nil
		else
			raise ArgumentError.new "unknown result"
		end
		ret
	end

	def self.sleep n
		if n > 0
			Fiber.yield Time.now + n
		end
	end



