									master.write ln
								end
								data = master.f_expectTTYStr "sdafsadfsadf: command not found"
								aout data
								Fiber.pararell do
									Fiber.fork do
										STDIN.raw!
										loop do
											begin
												d1 = STDIN.f_getTTYStr
											rescue EOFError
												break
											end
											master.write d1
											master.flush
										end
									end
									Fiber.fork do
