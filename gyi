if [ -z "$NO_GYI" ]; then
	set -e
	if [  -z "`which gy_install`" ]; then
		PKG_D="$HOME/.local/downloads/yk_packages"
		THIS_P="$PKG_D/gy_support"
		mkdir -p $PKG_D
		git clone https://github.com/Yougain/gy_support.git "$THIS_P"
		(
			NO_GYI=1 . "$THIS_P"/install
		)
		echo -e "\033[33mCAUTION: ~/.bashrc and/or ~/.zshrc has been modified. Please re-run this script after installation.\033[0m"
	fi
	. gy_install
fi



