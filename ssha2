	IOWithReadException = {}
	IOWithWriteException = {}
	IOWithErrorException = {}

	def getCompleted
		@buff ||= "".b # ASCII-8bit
	 	return nil if @buff.empty?

	  i = @buff.bytesize - 1
	  cont = 0

	  	while i >= 0 && (@buff.getbyte(i) & 0b11000000) == 0b10000000
	   	cont += 1
	   	i -= 1
	  	end
		if cont == 0
			ret = @buff
			@buff = "".b
	 		return ret
		end

		lead = @buff.getbyte(i)
		need = 	case lead
	         	when 0xC2..0xDF then 1
	         	when 0xE0..0xEF then 2
	         	when 0xF0..0xF4 then 3
	         	else 0
	         	end

		if need > 0 && cont < need
			pending_start = i + 1
			completed = buf.byteslice(0, pending_start)
			pending = buf.byteslice(pending_start, buf.bytesize - pending_start)
			@buff.replace(pending)
	   	return completed
		end

		ret = @buff
		@buff = "".b
 		return ret
	end

	def f_getTTYStr t = nil
		@buff ||= "".b # ASCII-8bit
		if t
			tout = Time.now + t
		end
		loop do
			if !@buff.empty?
				if Encoding.default_external == Encoding::UTF_8
					completed = getCompleted
					if completed
						return binaryToDisplayUtf8(completed)
					end
				else
					begin
						dst = +""
						@@conv.primitive_convert(@buff, dst)
						if !dst.empty?
							return dst
						end
					rescue Encoding::InvalidByteSequenceError
						ret = @buff.encode(Encoding.default_external, "ASCII-8BIT", invalid: :replace, undef: :replace, replace: "?")
						@buff.clear
						return ret
					end
				end
			end
			Fiber.wait(self, :read, tout)
			begin
				@buff += readpartial 1024
			rescue Errno::EIO
				if tty?
					raise EOFError.new
				else
					raise
				end
			end
		end
	end

	def f_getTTYLine t = nil
		f_expectTTYStr "\n", t = nil
	end

	def f_expectTTYStr expr, t = nil
		@buff ||= "".b # ASCII-8bit
		if t
			tout = Time.now + t
		end
		loop do
			case expr
			when String
				fe = expr.force_encoding("ASCII-8BIT")
				exprPos = @buff.index fe
				if exprPos
					untilExpr = @buff.slice! 0...(exprPos + fe.size)
					return binaryToDisplayUtf8(untilExpr)
				end
			when Regexp
				bm = @buff.force_encoding(expr.to_s.encoding)
				if bm =~ expr
					bm.replace($')
					@buff.replace(bm.b)
					return binaryToDisplayUtf8($` + $&)
				end
			end
			tmp = Fiber.wait(self, :read, tout)
			if tmp.is_a? Exception
				raise tmp
			end
				@buff += readpartial 1024
			#else
			#	p.blue
			#end
		end
	end

	def readable?
	  mode = io.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
	  mode == Fcntl::O_RDONLY || mode == Fcntl::O_RDWR
	end

	def writable?
	  mode = io.fcntl(Fcntl::F_GETFL) & Fcntl::O_ACCMODE
	  mode == Fcntl::O_WRONLY || mode == Fcntl::O_RDWR
	end

	attr_reader :read_exception, :write_exception, :error_exception

	def set_exception e, mode # raise exception when no data arrived
		case mode
		when :read
			IOWithReadException[self] = e
		when :write
			IOWithWtiteException[self] = e
		when :error
			IOWithErrorException[self] = e
		else
			raise ArgumentError.new("cannot determine readable or writable")
		end
	end

end


def do_ssh *args
	verbose = true if args.include? "-v"
	if KEY_CHECK_IN_ADVANCE
		exec *args
	else
		#ENV.delete 'SSH_ASKPASS'
		wsz = STDIN.winsize
		shellID = "#{FPID}.#{rand(10000000000).to_s}"
		args.pop # remove temporary shell for KEY_CHECK_IN_ADVANCE=1
		args.push "SHELL_ID=#{shellID} WINSZ=#{wsz.join(",")} bash --rcfile "' <(echo "source ~/.bashrc; PS1=\"[MyRemotePrompt]\$ \"")'
		case args[0]
		when "ssh"
		when "ssh.exe"
			args.unshift "-Xallow-non-tty"
			args.unshift "/mnt/c/Program Files/Git/usr/bin/winpty.exe"
		end
		if !verbose
			args.insert 1, "-v"
		end
		pid = nil
		wsz = STDIN.winsize
		slv = nil
		trap :WINCH do
			begin
				new_wsz = STDIN.winsize
				if new_wsz != wsz
					wsz = new_wsz
					if pid
						begin
							if slv && !slv.closed?
								slv.winsize = wsz
								Process.kill :WINCH, pid if pid
							end
						rescue Errno::ESRCH
						end
					end
				end
			rescue
			end
		end
		eoutLog = File.open "#{SSHA_HOME}/logs/ssha2_eout.log", "a"
		PTY.open do |master, slave|
			slv = slave
			master.sync = true
			slave.sync = true
			slave.winsize = wsz
			#ENV['SSH_ASKPASS'] = ""
			er, ew = IO.pipe
			pid = fork do
				master.close
				er.close
				STDOUT.reopen slave
				STDIN.reopen slave
				STDERR.reopen ew
				slave.close
				3.upto(1023) do |fd|
					IO.for_fd(fd).close rescue nil
				end
				exec *args
			end
			ew.close
			begin
				#STDERR.reopen slave, "w"
				slave.close
				begin
					vport = nil
					Fiber.pararell do
						Fiber.fork do
							allocPortLine = nil
							loop do
								begin
									line = er.f_getTTYLine
								rescue EOFError => e
									STDIN.set_exception EOFError.new, :read
									break
								end
								dlog "err_out: #{line.inspect}"
								if verbose
									line.gsub!(/Error:.*\n|^.*disabled port forwarding/i) { "\e[31m#{$&}\e[0m" }
									STDERR.write line
									STDERR.flush
								else
									if line !~ /^debug\d+: / && line != allocPortLine
										STDERR.write line
									end
								end
								if !vport && line =~ /Allocated port (\d+) for remote forward to 127.0.0.1:\d+/
									vport = $1
									allocPortLine = line
								end
							end
						end
						Fiber.fork do
							begin
								data = master.f_expectTTYStr "]$"
							rescue EOFError, Errno::EIO
							end
							if data
								aout data
								# if !cmded && strip_control_chars(residue) =~ /\]\$/ # command prompt
								pre_scr = <<~END
