										fi
									done
								END
								pre_scr.each_line do |ln|
									ln.lstrip!
									master.write ln
								end
								pre_scr = <<~END
									for ent in /tmp/vscode-ssh-ports/$SYS_START/*; do
										if [ $ent != /tmp/vscode-ssh-ports/$SYS_START/* ];then
											tmp=$(basename $ent)
											if ! kill -s 0 ${tmp#*.} 2>&1; then
